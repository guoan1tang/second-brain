{
  "manifest_version": 3,
  "name": "Second Brain Web Clipper",
  "version": "1.0.0",
  "description": "把网页一键存入你的第二大脑(标题/网址/选中文字/备注)",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "存入第二大脑"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
